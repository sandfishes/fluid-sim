[
  {
    "adapter": "CodeLLDB",
    "label": "odindebug",
    "request": "launch",
    "program": "debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "LD_LIBRARY_PATH": "$LD_LIBRARY_PATH:$ZED_WORKTREE_ROOT/src/gpu/slang/lib",
    },
    "build": {
      "command": "odin",
      "args": ["build", "src", "-debug", "-out:debug"],
    },
  },
]
